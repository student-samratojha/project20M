<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Profile | SamCore DevVault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-b from-slate-50 via-white to-slate-100 min-h-screen p-8">

  <div class="max-w-7xl mx-auto">

    <!-- Top Profile Card -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-xl overflow-hidden mb-10">
      
      <!-- Decorative Banner -->
      <div class="h-32 bg-[url(/bg.webp)] bg-cover bg-no-repeat bg-top"></div>

      <div class="px-8 pb-8">
        <div class="relative flex flex-col md:flex-row gap-6">
          
          <!-- Avatar (Overlapping) -->
          <div class="-mt-12 flex-shrink-0 flex justify-center md:justify-start">
            <div class="p-1 bg-white rounded-full shadow-sm">
              <img
                src="<%= user.profilePic || 'https://i.pravatar.cc/150' %>"
                class="w-32 h-32 rounded-full object-cover border-2 border-slate-100"
              />
            </div>
          </div>

          <!-- Content -->
          <div class="pt-2 md:pt-4 flex-1">
            <div class="flex flex-col md:flex-row justify-between items-start gap-4">
              <div class="text-center md:text-left w-full">
                <h1 class="text-3xl font-bold text-slate-900"><%= user.name %></h1>
                <p class="text-slate-500 font-medium"><%= user.email %></p>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-3 w-full md:w-auto justify-center md:justify-end">
                <a
                  href="/secure/edit"
                  class="px-5 py-2.5 bg-slate-900 flex-shrink-0 text-white rounded-xl text-sm font-semibold hover:bg-slate-800 transition shadow-lg shadow-slate-200"
                >
                  Edit Profile
                </a>
                <a
                  href="/auth/logout"
                  class="px-5 py-2.5 bg-white border border-slate-200 text-red-600 rounded-xl text-sm font-semibold hover:bg-red-50 hover:border-red-100 transition"
                >
                  Logout
                </a>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mt-2 justify-center md:justify-start">
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-lg text-sm font-semibold capitalize">
                <%= user.role %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= user.city || 'No city added' %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= user.stack || 'No stack added' %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= user.education || 'No education' %>
              </span>
            </div>

            <!-- Bio -->
            <p class="text-slate-600 mt-3 leading-relaxed text-center md:text-left">
              <%= user.bio || 'No bio added yet.' %>
            </p>

            <!-- Metadata -->
            <div class="mt-3 pt-4 border-t border-slate-400 flex flex-wrap justify-center md:justify-start gap-6 text-xs text-slate-400 font-medium uppercase tracking-wide">
              <span>Created: <%= user.createdAt.toLocaleString()%></span>
              <span>Updated: <%= user.updatedAt.toLocaleString() %></span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Languages -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8 mb-10">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Languages & Skills
      </h2>

      <div class="grid md:grid-cols-2 gap-6">

        <% user.languages.forEach(lang => { %>

          <div>
            <div class="flex justify-between mb-1">
              <span class="font-medium text-slate-700"><%= lang.name %></span>
              <span class="text-sm text-slate-500"><%= lang.level %>%</span>
            </div>

            <div class="w-full bg-slate-200 rounded-full h-3">
              <div
                class="bg-indigo-600 h-3 rounded-full"
                style="width: <%= lang.level %>%"
              ></div>
            </div>
          </div>

        <% }) %>

      </div>

    </div>

    <!-- Projects -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8 mb-10">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Projects
      </h2>

      <div class="grid md:grid-cols-2 gap-5">

        <% user.projects.forEach(project => { %>
          <div class="bg-slate-50 border rounded-2xl p-5 hover:shadow-md transition">
            <p class="text-slate-700 font-medium"><%= project %></p>
          </div>
        <% }) %>

      </div>

    </div>

    <!-- Audit Logs -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Recent Activity
      </h2>

      <div class="space-y-4">

        <% audits.forEach(audit => { %>
          <div class="bg-slate-50 border rounded-2xl p-4 flex justify-between items-center">
            <div>
              <p class="text-slate-800 font-medium"><%= audit.action %></p>
            </div>
            <p class="text-sm text-slate-500"><%= audit.createdAt %></p>
          </div>
        <% }) %>

      </div>

    </div>

  </div>

</body>
</html>