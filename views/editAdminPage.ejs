<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Edit Profile Admin | SamCore DevVault</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-b from-slate-50 via-white to-slate-100 min-h-screen flex items-center justify-center px-4 py-12"
  >
    <div
      class="w-full max-w-5xl bg-white border border-slate-200 rounded-3xl shadow-2xl p-10"
    >
      <!-- Header -->
      <div class="text-center mb-10">
        <p
          class="inline-block px-4 py-2 bg-indigo-50 text-indigo-700 rounded-full text-sm font-medium mb-4"
        >
          Admin Profile Editor
        </p>

        <h1 class="text-4xl font-bold text-slate-900">Edit Your Profile</h1>

        <p class="text-slate-500 mt-3 text-lg">
          Keep your developer identity updated ✨
        </p>
      </div>

      <!-- Form -->
      <form
        action="/secure/update"
        method="POST"
        class="grid grid-cols-1 md:grid-cols-2 gap-6"
      >
        <div>
          <label class="text-slate-700 font-medium block mb-2">Full Name</label>
          <input
            type="text"
            name="name"
            value="<%= user.name %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div>
          <label class="text-slate-700 font-medium block mb-2">Email</label>
          <input
            type="email"
            name="email"
            value="<%= user.email %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div>
          <label class="text-slate-700 font-medium block mb-2">Bio</label>
          <input
            type="text"
            name="bio"
            value="<%= user.bio %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div>
          <label class="text-slate-700 font-medium block mb-2"
            >Profile Pic URL</label
          >
          <input
            type="text"
            name="profilePic"
            value="<%= user.profilePic %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

<div class="md:col-span-2 mt-2">
  <div class="flex items-center justify-between mb-4">
    <label class="text-slate-700 font-medium">Languages</label>

    <button
      type="button"
      onclick="addLanguage()"
      class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-medium hover:bg-indigo-700 transition"
    >
      + Add Language
    </button>
  </div>

  <div id="languageContainer" class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <% user.languages.forEach((lang) => { %>
      <div class="border border-slate-200 rounded-xl p-4 bg-slate-50 shadow-sm">

        <input
          type="text"
          name="languageNames"
          value="<%= typeof lang === 'string' ? lang : lang.name %>"
          placeholder="Language Name"
          class="w-full px-3 py-2 rounded-lg border border-slate-300 mb-3 outline-none bg-white"
        />

        <input
          type="number"
          name="languageLevels"
          value="<%= typeof lang === 'string' ? '' : lang.level %>"
          placeholder="Skill %"
          class="w-full px-3 py-2 rounded-lg border border-slate-300 outline-none bg-white"
        />

      </div>
    <% }) %>

  </div>
</div>
        <div>
          <label class="text-slate-700 font-medium block mb-2"
            >Tech Stack</label
          >
          <input
            type="text"
            name="stack"
            value="<%= user.stack %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div>
          <label class="text-slate-700 font-medium block mb-2">City</label>
          <input
            type="text"
            name="city"
            value="<%= user.city %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div>
          <label class="text-slate-700 font-medium block mb-2">Education</label>
          <input
            type="text"
            name="education"
            value="<%= user.education %>"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          />
        </div>

        <div class="md:col-span-2">
          <label class="text-slate-700 font-medium block mb-2">Projects</label>
          <textarea
            name="projects"
            rows="4"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          >
<%= user.projects.join(', ') %></textarea
          >
        </div>

        <!-- Button -->
        <div class="md:col-span-2 flex item-center gap-4 mt-4">
          <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-4 rounded-2xl shadow-md transition"
          >
            Update Profile
          </button>
            <a href="/secure/<%=user.role%>"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-center font-semibold py-4 rounded-2xl shadow-md transition"
                >Back to Dashboard</a>
        </div>
      </form>
    
    </div>
    <script>
  function addLanguage() {
    const container = document.getElementById("languageContainer");

    const box = document.createElement("div");
    box.className = "border border-slate-200 rounded-xl p-4 bg-slate-50";

    box.innerHTML = `
      <input
        type="text"
        name="languageNames"
        placeholder="Language Name"
        class="w-full px-3 py-2 rounded-lg border border-slate-300 mb-3 outline-none bg-white"
      />

      <input
        type="number"
        name="languageLevels"
        placeholder="Skill %"
        class="w-full px-3 py-2 rounded-lg border border-slate-300 outline-none bg-white"
      />
    `;

    container.appendChild(box);
  }
</script>
  </body>
</html>
