<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | SamCore DevVault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-b from-slate-50 via-white to-slate-100 min-h-screen p-8">

  <div class="max-w-7xl mx-auto">

    <!-- Heading -->
    <div class="mb-10">
      <p class="inline-block px-4 py-2 bg-indigo-50 text-indigo-700 rounded-full text-sm font-medium mb-4">
        Admin Control Center
      </p>

      <h1 class="text-4xl font-bold text-slate-900">
        Admin Dashboard
      </h1>

      <p class="text-slate-500 mt-2 text-lg">
        Manage users, activity logs and system overview ⚡
      </p>
    </div>

    <!-- Admin Profile -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-xl p-8 mb-10 flex flex-col md:flex-row items-center justify-between gap-8">

      <div class="flex items-center gap-6">

        <img
          src="<%= admin.profilePic || 'https://i.pravatar.cc/150' %>"
          class="w-24 h-24 rounded-full object-cover border-4 border-indigo-500 shadow-md"
        />

        <div>
          <h2 class="text-2xl font-bold text-slate-900"><%= admin.name %></h2>
          <p class="text-slate-500"><%= admin.email %></p>
          <p class="text-indigo-600 font-medium mt-1 capitalize"><%= admin.role %></p>
        </div>

      </div>

      <div class="text-slate-600 space-y-2 text-sm">
        <p><span class="font-semibold text-slate-800">City:</span> <%= admin.city %></p>
        <p><span class="font-semibold text-slate-800">Stack:</span> <%= admin.stack %></p>
        <p><span class="font-semibold text-slate-800">Education:</span> <%= admin.eductaion %></p>
      </div>

      <a
        href="/logout"
        class="px-6 py-3 bg-red-500 text-white rounded-2xl font-semibold hover:bg-red-600 transition shadow-md"
      >
        Logout
      </a>

    </div>

    <!-- Stats -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Users</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalUsers %></p>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Activity</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalActivity %></p>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Projects</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalProjects %></p>
      </div>

    </div>

    <!-- Users -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8 mb-10">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Registered Users
      </h2>

      <div class="space-y-4">

        <% users.forEach(user => { %>

          <div class="flex justify-between items-center bg-slate-50 border rounded-2xl p-4">

            <div class="flex items-center gap-4">

              <img
                src="<%= user.profilePic || 'https://i.pravatar.cc/100' %>"
                class="w-14 h-14 rounded-full object-cover"
              />

              <div>
                <h3 class="font-semibold text-slate-900"><%= user.name %></h3>
                <p class="text-sm text-slate-500"><%= user.email %></p>
                <p class="text-xs text-indigo-600"><%= user.role %></p>
              </div>

            </div>

            <div>

              <% if(!user.isDeleted){ %>
                <form action="/admin/delete/<%= user._id %>" method="POST">
                  <button class="px-4 py-2 bg-red-500 text-white rounded-xl hover:bg-red-600 transition">
                    Delete
                  </button>
                </form>
              <% } else { %>
                <form action="/admin/restore/<%= user._id %>" method="POST">
                  <button class="px-4 py-2 bg-green-500 text-white rounded-xl hover:bg-green-600 transition">
                    Restore
                  </button>
                </form>
              <% } %>

            </div>

          </div>

        <% }) %>

      </div>

    </div>

    <!-- Audits -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Recent Audit Logs
      </h2>

      <div class="space-y-4">

        <% audits.forEach(audit => { %>
          <div class="bg-slate-50 border rounded-2xl p-4">
            <p class="text-slate-700"><%= audit %></p>
          </div>
        <% }) %>

      </div>

    </div>

  </div>

</body>
</html>