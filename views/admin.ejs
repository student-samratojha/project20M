<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | SamCore DevVault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-b from-slate-50 via-white to-slate-100 min-h-screen p-8">

  <div class="max-w-7xl mx-auto">

    <!-- Top Profile Card -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-xl overflow-hidden mb-10">
      
      <!-- Decorative Banner -->
      <div class="h-32 bg-[url(/bg.webp)] bg-cover bg-no-repeat bg-top"></div>

      <div class="px-8 pb-8">
        <div class="relative flex flex-col md:flex-row gap-6">
          
          <!-- Avatar (Overlapping) -->
          <div class="-mt-12 flex-shrink-0 flex justify-center md:justify-start">
            <div class="p-1 bg-white rounded-full shadow-sm">
              <img
                src="<%= admin.profilePic || 'https://i.pravatar.cc/150' %>"
                class="w-32 h-32 rounded-full object-cover border-2 border-slate-100"
              />
            </div>
          </div>

          <!-- Content -->
          <div class="pt-2 md:pt-4 flex-1">
            <div class="flex flex-col md:flex-row justify-between items-start gap-4">
              <div class="text-center md:text-left w-full">
                <h1 class="text-3xl font-bold text-slate-900"><%= admin.name %></h1>
                <p class="text-slate-500 font-medium"><%= admin.email %></p>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-3 w-full md:w-auto justify-center md:justify-end">
                <a
                  href="/secure/update"
                  class="px-5 py-2.5 bg-slate-900 flex-shrink-0 text-white rounded-xl text-sm font-semibold hover:bg-slate-800 transition shadow-lg shadow-slate-200"
                >
                  Edit Profile
                </a>
                <a
                  href="/auth/logout"
                  class="px-5 py-2.5 bg-white border border-slate-200 text-red-600 rounded-xl text-sm font-semibold hover:bg-red-50 hover:border-red-100 transition"
                >
                  Logout
                </a>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mt-2 justify-center md:justify-start">
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-lg text-sm font-semibold capitalize">
                <%= admin.role %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= admin.city || 'No city added' %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= admin.stack || 'No stack added' %>
              </span>
              <span class="px-3 py-1 bg-slate-50 text-slate-600 border border-slate-200 rounded-lg text-sm font-medium">
                <%= admin.education || 'No education' %>
              </span>
            </div>

            <!-- Bio -->
            <p class="text-slate-600 mt-3 leading-relaxed text-center md:text-left">
              <%= admin.bio || 'No bio added yet.' %>
            </p>

            <!-- Metadata -->
            <div class="mt-3 pt-4 border-t border-slate-400 flex flex-wrap justify-center md:justify-start gap-6 text-xs text-slate-400 font-medium uppercase tracking-wide">
              <span>Created: <%= admin.createdAt ? admin.createdAt.toLocaleString() : '' %></span>
              <span>Updated: <%= admin.updatedAt ? admin.updatedAt.toLocaleString() : '' %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Users</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalUsers %></p>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Activity</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalActivity %></p>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-6">
        <h2 class="text-slate-500 text-sm">Total Projects</h2>
        <p class="text-4xl font-bold text-slate-900 mt-3"><%= totalProjects %></p>
      </div>

    </div>

    <!-- Users -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8 mb-10">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Registered Users
      </h2>

      <div class="space-y-4">

        <% users.forEach(user => { %>

          <div class="flex justify-between items-center bg-slate-50 border rounded-2xl p-4">

            <div class="flex items-center gap-4">

              <img
                src="<%= user.profilePic || 'https://i.pravatar.cc/100' %>"
                class="w-14 h-14 rounded-full object-cover"
              />

              <div>
                <h3 class="font-semibold text-slate-900"><%= user.name %></h3>
                <p class="text-sm text-slate-500"><%= user.email %></p>
                <p class="text-xs text-indigo-600"><%= user.role %></p>
              </div>

            </div>

            <div>

              <% if(!user.isDeleted){ %>
                <form action="/admin/delete/<%= user._id %>" method="POST">
                  <button class="px-4 py-2 bg-red-500 text-white rounded-xl hover:bg-red-600 transition">
                    Delete
                  </button>
                </form>
              <% } else { %>
                <form action="/admin/restore/<%= user._id %>" method="POST">
                  <button class="px-4 py-2 bg-green-500 text-white rounded-xl hover:bg-green-600 transition">
                    Restore
                  </button>
                </form>
              <% } %>

            </div>

          </div>

        <% }) %>

      </div>

    </div>

    <!-- Audits -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm p-8">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">
        Recent Audit Logs
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-slate-500 text-sm border-b border-slate-200">
              <th class="pb-3 font-semibold pl-2">User</th>
              <th class="pb-3 font-semibold">Action</th>
              <th class="pb-3 font-semibold">Route Info</th>
              <th class="pb-3 font-semibold">Device / IP</th>
              <th class="pb-3 font-semibold">Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% audits.forEach(audit => { %>
              <tr class="hover:bg-slate-50 transition-colors group">
                
                <!-- User Column -->
                <td class="py-4 pl-2 align-top">
                  <div class="flex items-center gap-3">
                    <% if (audit.user) { %>
                      <img src="<%= audit.user.profilePic || 'https://i.pravatar.cc/50' %>" class="w-10 h-10 rounded-full object-cover border border-slate-200" />
                      <div>
                        <p class="font-medium text-slate-900 text-sm"><%= audit.user.name %></p>
                        <p class="text-xs text-indigo-500 font-medium"><%= audit.user.role %></p>
                      </div>
                    <% } else { %>
                      <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                        <span class="text-xs font-bold">?</span>
                      </div>
                      <span class="text-sm text-slate-500 font-medium">Guest</span>
                    <% } %>
                  </div>
                </td>

                <!-- Action Column -->
                <td class="py-4 align-top">
                  <span class="inline-block px-2 py-1 bg-slate-100 text-slate-700 rounded-md text-xs font-semibold"><%= audit.action %></span>
                </td>

                <!-- Route Column -->
                <td class="py-4 align-top">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold font-mono text-indigo-600"><%= audit.method %></span>
                    <span class="text-xs text-slate-500 font-mono break-all"><%= audit.route %></span>
                  </div>
                </td>

                <!-- IP/Agent Column -->
                <td class="py-4 align-top max-w-xs">
                  <p class="text-sm font-mono text-slate-700"><%= audit.ip || 'Unknown IP' %></p>
                  <p class="text-xs text-slate-400 truncate mt-1" title="<%= audit.userAgent %>">
                    <%= audit.userAgent || 'Unknown User Agent' %>
                  </p>
                </td>

                <!-- Time Column -->
                <td class="py-4 align-top whitespace-nowrap">
                  <span class="text-sm text-slate-500">
                    <%= audit.createdAt ? new Date(audit.createdAt).toLocaleString() : 'N/A' %>
                  </span>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>

        <% if(audits.length === 0) { %>
          <div class="text-center py-8 text-slate-400 text-sm">No audit logs found.</div>
        <% } %>
      </div>

    </div>

  </div>

</body>
</html>