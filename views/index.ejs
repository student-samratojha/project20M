<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SamCore DevVault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-b from-slate-50 via-white to-slate-100 text-slate-900 font-sans">

  <!-- Navbar -->
  <nav class="bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">

      <a href="/" class="text-2xl font-bold tracking-tight text-indigo-700">
        SamCore DevVault
      </a>

      <div class="flex gap-4 items-center">
        <a href="/auth/login" class="text-slate-700 font-medium hover:text-indigo-700 transition">
          Login
        </a>

        <a href="/auth/register"
          class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 shadow-sm transition">
          Register
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 py-24">

    <div class="grid md:grid-cols-2 gap-16 items-center">

      <!-- Left -->
      <div>

        <p class="inline-block px-4 py-2 bg-indigo-50 text-indigo-700 rounded-full text-sm font-medium mb-6">
          Developer Profile Management Platform
        </p>

        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
          Organize Developer
          <span class="text-indigo-600">Profiles, Skills & Projects</span>
          with Confidence
        </h1>

        <p class="text-lg text-slate-600 leading-relaxed mb-8 max-w-xl">
          A professional platform designed to manage programmer identities,
          technical stacks, project history and audit activity in one secure workspace.
        </p>

        <div class="flex gap-4">

          <a href="/auth/register"
            class="px-8 py-4 bg-indigo-600 text-white rounded-2xl font-semibold shadow-lg hover:bg-indigo-700 transition">
            Get Started
          </a>

          <a href="/auth/login"
            class="px-8 py-4 bg-white border border-slate-300 rounded-2xl font-semibold hover:border-indigo-600 transition">
            Explore Login
          </a>

        </div>

      </div>

      <!-- Right -->
      <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 p-10">

        <div class="grid grid-cols-2 gap-6">

          <div class="bg-slate-50 rounded-2xl p-6 text-center border hover:shadow-md transition">
            <div class="text-4xl mb-3">👨‍💻</div>
            <h3 class="font-bold text-lg">Profiles</h3>
            <p class="text-sm text-slate-500 mt-2">Professional records</p>
          </div>

          <div class="bg-slate-50 rounded-2xl p-6 text-center border hover:shadow-md transition">
            <div class="text-4xl mb-3">🚀</div>
            <h3 class="font-bold text-lg">Projects</h3>
            <p class="text-sm text-slate-500 mt-2">Portfolio tracking</p>
          </div>

          <div class="bg-slate-50 rounded-2xl p-6 text-center border hover:shadow-md transition">
            <div class="text-4xl mb-3">⚙️</div>
            <h3 class="font-bold text-lg">Languages</h3>
            <p class="text-sm text-slate-500 mt-2">Tech stack archive</p>
          </div>

          <div class="bg-slate-50 rounded-2xl p-6 text-center border hover:shadow-md transition">
            <div class="text-4xl mb-3">📈</div>
            <h3 class="font-bold text-lg">Audit Logs</h3>
            <p class="text-sm text-slate-500 mt-2">Activity history</p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Stats -->
  <section class="max-w-7xl mx-auto px-6 py-10">

    <div class="grid md:grid-cols-3 gap-6">

      <div class="bg-white rounded-2xl border p-8 shadow-sm text-center">
        <h2 class="text-4xl font-bold text-indigo-600">100%</h2>
        <p class="text-slate-500 mt-2">Structured User Records</p>
      </div>

      <div class="bg-white rounded-2xl border p-8 shadow-sm text-center">
        <h2 class="text-4xl font-bold text-indigo-600">Secure</h2>
        <p class="text-slate-500 mt-2">Authentication & Role Control</p>
      </div>

      <div class="bg-white rounded-2xl border p-8 shadow-sm text-center">
        <h2 class="text-4xl font-bold text-indigo-600">Live</h2>
        <p class="text-slate-500 mt-2">Audit Monitoring</p>
      </div>

    </div>

  </section>

  <!-- Features -->
  <section class="max-w-7xl mx-auto px-6 py-20">

    <h2 class="text-4xl font-bold text-center mb-14">
      Core Platform Features
    </h2>

    <div class="grid md:grid-cols-3 gap-8">

      <div class="bg-white p-8 rounded-3xl border shadow-sm hover:shadow-lg transition">
        <div class="text-4xl mb-4">🔐</div>
        <h3 class="text-xl font-bold mb-3">Protected Accounts</h3>
        <p class="text-slate-600 leading-relaxed">
          Secure login, registration and profile access for controlled user management.
        </p>
      </div>

      <div class="bg-white p-8 rounded-3xl border shadow-sm hover:shadow-lg transition">
        <div class="text-4xl mb-4">📂</div>
        <h3 class="text-xl font-bold mb-3">Project Repository</h3>
        <p class="text-slate-600 leading-relaxed">
          Save development work, organize portfolio entries and maintain history.
        </p>
      </div>

      <div class="bg-white p-8 rounded-3xl border shadow-sm hover:shadow-lg transition">
        <div class="text-4xl mb-4">🧠</div>
        <h3 class="text-xl font-bold mb-3">Skill Tracking</h3>
        <p class="text-slate-600 leading-relaxed">
          Languages, stacks and technical capabilities recorded professionally.
        </p>
      </div>

    </div>

  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-6 py-20">

    <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 rounded-3xl p-14 text-white text-center shadow-xl">

      <h2 class="text-4xl font-bold mb-4">
        Start Building Your Developer Identity
      </h2>

      <p class="text-indigo-100 mb-8 text-lg">
        A clean platform for serious developers to maintain records professionally.
      </p>

      <a href="/auth/register"
        class="px-10 py-4 bg-white text-indigo-700 rounded-2xl font-bold hover:bg-slate-100 transition">
        Create Account
      </a>

    </div>

  </section>

  <!-- Footer -->
  <footer class="bg-white border-t py-8 text-center text-slate-500">
    © 2026 SamCore DevVault — Crafted by Samrat ✨
  </footer>

</body>
</html>