<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login | SamCore DevVault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-b from-slate-50 via-white to-slate-100 min-h-screen flex items-center justify-center px-4">

  <div class="w-full max-w-md bg-white border border-slate-200 rounded-3xl shadow-2xl p-10">

    <!-- Header -->
    <div class="text-center mb-8">

      <p class="inline-block px-4 py-2 bg-indigo-50 text-indigo-700 rounded-full text-sm font-medium mb-4">
        Secure Developer Access
      </p>

      <h1 class="text-4xl font-bold text-slate-900">
        Welcome Back
      </h1>

      <p class="text-slate-500 mt-3 text-lg">
        Login to continue your workspace 🚀
      </p>

    </div>

    <!-- Form -->
    <form action="/auth/login" method="POST" class="space-y-6">

      <div>
        <label class="text-slate-700 font-medium block mb-2">Email</label>
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          required
        />
      </div>

      <div>
        <label class="text-slate-700 font-medium block mb-2">Password</label>
        <input
          type="password"
          name="password"
          placeholder="Enter your password"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
          required
        />
      </div>

      <!-- Button -->
      <button
        type="submit"
        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-4 rounded-2xl shadow-md transition"
      >
        Login
      </button>

    </form>

    <!-- Footer -->
    <div class="text-center mt-8">
      <p class="text-slate-500">
        Don’t have an account?
        <a href="/auth/register" class="text-indigo-600 font-medium hover:underline">
          Register
        </a> | <a href="/" class="text-indigo-600 font-medium hover:underline">Home</a>
      </p>
    </div>

  </div>

</body>
</html>